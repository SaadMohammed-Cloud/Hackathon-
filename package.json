{
  "name": "transitalert",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Accessible real-time transit PA announcements for deaf, hard-of-hearing, blind and low-vision commuters.",
  "scripts": {
    "start": "concurrently -n relay,web -c yellow,cyan \"npm:relay\" \"npm:dev\"",
    "dev": "vite --host",
    "relay": "node server/relay.js",
    "build": "vite build",
    "preview": "vite preview --host"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.8"
  }
}
